# Create on the hub before applying hub/cluster manifests:
#   oc create secret generic pull-secret \
#     -n REPLACE_CLUSTER_NAME \
#     --from-file=.dockerconfigjson="${PULL_SECRET_FILE}" \
#     --type=kubernetes.io/dockerconfigjson
#
# Or copy this file, replace the data value, and apply:
apiVersion: v1
kind: Secret
metadata:
  name: pull-secret
  namespace: REPLACE_CLUSTER_NAME
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    REPLACE_PULL_SECRET_JSON
