# Create on the hub before applying BareMetalHost:
#   oc create secret generic bmc-credentials \
#     -n REPLACE_CLUSTER_NAME \
#     --from-literal=username="${BMC_USERNAME}" \
#     --from-literal=password="${BMC_PASSWORD}"
#
# Or copy this file, replace values, and apply:
apiVersion: v1
kind: Secret
metadata:
  name: bmc-credentials
  namespace: REPLACE_CLUSTER_NAME
type: Opaque
stringData:
  username: REPLACE_BMC_USERNAME
  password: REPLACE_BMC_PASSWORD
