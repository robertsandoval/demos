# Copy to site.env and fill in values for your environment.
# Do not commit site.env or real secrets.

# Managed cluster identity
CLUSTER_NAME=demo-sno
BASE_DOMAIN=example.com
CLUSTER_IMAGE_SET=img4.22.0-x86-64-appsub

# SNO networking (adjust for your lab)
MACHINE_NETWORK_CIDR=192.168.1.0/24
# Optional for multi-node; leave empty for typical SNO DHCP labs
# API_VIP=
# INGRESS_VIP=

# Host / BMC (kubevirt-redfish or physical Redfish)
HOST_NAME=demo-sno-node1
BOOT_MAC_ADDRESS=52:54:00:00:00:01
BMC_ADDRESS=redfish-virtualmedia+https://REPLACE_REDFISH_HOST/redfish/v1/Systems/REPLACE_SYSTEM_ID
BMC_USERNAME=admin
BMC_PASSWORD=password

# Credentials on the hub (paths to local files used when creating secrets)
PULL_SECRET_FILE=${HOME}/pull-secret.json
SSH_PUBLIC_KEY_FILE=${HOME}/.ssh/id_rsa.pub

# OpenShift GitOps Application destination (managed cluster name in Argo CD)
ARGOCD_NAMESPACE=openshift-gitops
GIT_REPO_URL=https://github.com/robertsandoval/demos.git
GIT_REVISION=main
